{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["node"],
    "rootDir": "src", "outDir": "dist", "strict": true,
    "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "declaration": true, "sourceMap": true
  },
  "include": ["src/**/*.ts"]
}
